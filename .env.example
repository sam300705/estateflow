# Public Supabase values. These are safe to expose to the browser and are required by EstateFlow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional direct Postgres connection for migration/admin tooling only.
# Keep real credentials server-side and out of NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://user:password@localhost:5432/estateflow
